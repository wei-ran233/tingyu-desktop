              "type": "string",
              "maxLength": 100
            }
          },
          "actions": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 129
                },
                "title": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            }
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "layout": {
            "type": "string",
            "maxLength": 8
          },
          "heading": {
            "type": "string",
            "maxLength": 100
          },
          "items": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 100
                },
                "command": {
                  "type": "string",
