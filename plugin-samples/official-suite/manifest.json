      "version": "1.0.0",
      "kind": "toolbar",
      "input": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 32
          },
          "suggestions": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "actions": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
