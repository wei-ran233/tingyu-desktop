          },
          "items": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 100
                },
                "command": {
                  "type": "string",
                  "maxLength": 8
                },
                "value": {
                  "type": "string",
                  "maxLength": 129
                }
              }
            }
          }
        }
      }
    }
  ]
}
