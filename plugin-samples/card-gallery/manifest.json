{
  "id": "lx.card-gallery",
  "name": "Card Gallery",
  "version": "1.1.0",
  "apiVersion": "1.2.0",
  "description": "Example card layout that uses the exact same collection commands as the official list.",
  "author": "听域",
  "main": "index.html",
  "icon": "icon.svg",
  "permissions": [
    "collection.read",
    "collection.commands",
    "plugin.pages",
    "theme.contribute",
    "storage.scoped",
    "settings.scoped"
  ],
  "collection": {
    "providers": [
      {
        "id": "card-gallery",
        "displayName": "Card gallery",
        "description": "Poster cards with cover art, inline play and the same command gateway.",
        "surfaces": [
          "search-music",
          "list-music",
          "songlist-detail-music",
          "leaderboard-music"
        ],
        "entry": "index.html",
        "icon": "icon.svg"
      }
    ]
  },
  "pages": [
    {
      "id": "gallery-guide",
      "title": "Card gallery guide",
      "entry": "page.html",
      "icon": "icon.svg",
      "order": 900,
      "placement": "tools"
    }
  ],
  "themes": [
    {
      "id": "gallery-amber",
      "name": "Gallery amber",
      "isDark": false,
      "tokens": {
        "--lx-accent": "#c47a1a",
        "--lx-accent-contrast": "#ffffff",
        "--lx-radius": "12px"
      }
    }
  ],
  "settings": [
    {
      "key": "guideTitle",
      "title": "说明页标题",
      "description": "修改后立即更新卡片视图说明页。",
      "type": "string",
      "default": "Card gallery",
      "maxLength": 80
    }
  ]
}
